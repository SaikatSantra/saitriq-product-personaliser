{% comment %}
  Saitriq Product Personalizer - App Embed
  Enables the product customization studio across the storefront when toggled ON in Theme Settings > App Embeds.
{% endcomment %}

<div
  id="saitriq-personalizer-embed"
  data-enabled="true"
  data-shop="{{ shop.permanent_domain }}"
  data-fabric-url="{{ 'fabric.min.js' | asset_url }}"
  style="display: none;"
></div>

{% schema %}
{
  "name": "Product Personalizer",
  "target": "body",
  "stylesheet": "personalizer.css",
  "javascript": "personalizer.js",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Customize Button Text",
      "default": "🎨 Customize This Product"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Accent Color",
      "default": "#008060"
    }
  ]
}
{% endschema %}
