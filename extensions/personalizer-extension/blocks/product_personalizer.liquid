{% assign current_product = product %}
{% if current_product == nil and block.settings.product != blank %}
  {% assign current_product = block.settings.product %}
{% endif %}

{% assign base_image = current_product.featured_image | default: current_product.featured_media %}
{% assign base_image_url = '' %}
{% if base_image %}
  {% assign base_image_url = base_image | image_url: width: 1200 %}
  {% unless base_image_url contains 'http' %}
    {% assign base_image_url = 'https:' | append: base_image_url %}
  {% endunless %}
{% endif %}

{% assign default_btn_text = 'personalizer.button_text' | t %}
{% if default_btn_text contains 'translation missing:' or default_btn_text == blank %}
  {% assign default_btn_text = '🎨 Customize This Product' %}
{% endif %}
{% assign btn_text = block.settings.button_text | default: default_btn_text %}
{% assign btn_color = block.settings.primary_color | default: '#008060' %}

<div class="saitriq-personalizer-root" id="saitriq-personalizer-{{ block.id }}" {{ block.shopify_attributes }}{% unless request.design_mode %} style="display: none;"{% endunless %}>
  <saitriq-personalizer
    data-product-id="{{ current_product.id }}"
    data-product-handle="{{ current_product.handle }}"
    data-product-title="{{ current_product.title | escape }}"
    data-product-image="{{ base_image_url }}"
    data-shop="{{ shop.permanent_domain }}"
    data-app-url="{{ block.settings.app_url | default: '' }}"
    data-fabric-url="{{ 'fabric.min.js' | asset_url }}"
    data-button-text="{{ btn_text | escape }}"
    data-primary-color="{{ btn_color | escape }}"
    data-auto-open="{{ block.settings.auto_open | default: false }}"
    data-design-mode="{% if request.design_mode %}true{% else %}false{% endif %}"
    data-locale="{{ request.locale.iso_code | downcase }}"
    {% unless request.design_mode %}style="display: none;"{% endunless %}
  >
    <script type="application/json" class="saitriq-locales-json">
      {
        "button_text": {{ 'personalizer.button_text' | t | json }},
        "modal_title": {{ 'personalizer.modal_title' | t | json }},
        "modal_subtitle": {{ 'personalizer.modal_subtitle' | t | json }},
        "front_side": {{ 'personalizer.front_side' | t | json }},
        "back_side": {{ 'personalizer.back_side' | t | json }},
        "product_options": {{ 'personalizer.product_options' | t | json }},
        "custom_text_title": {{ 'personalizer.custom_text_title' | t | json }},
        "your_message": {{ 'personalizer.your_message' | t | json }},
        "text_placeholder": {{ 'personalizer.text_placeholder' | t | json }},
        "font_family": {{ 'personalizer.font_family' | t | json }},
        "align_left": {{ 'personalizer.align_left' | t | json }},
        "align_center": {{ 'personalizer.align_center' | t | json }},
        "align_right": {{ 'personalizer.align_right' | t | json }},
        "print_ink_color": {{ 'personalizer.print_ink_color' | t | json }},
        "pick_custom_color": {{ 'personalizer.pick_custom_color' | t | json }},
        "upload_title": {{ 'personalizer.upload_title' | t | json }},
        "upload_browse": {{ 'personalizer.upload_browse' | t | json }},
        "upload_or_drag": {{ 'personalizer.upload_or_drag' | t | json }},
        "upload_hint": {{ 'personalizer.upload_hint' | t | json }},
        "change_photo": {{ 'personalizer.change_photo' | t | json }},
        "remove_photo": {{ 'personalizer.remove_photo' | t | json }},
        "uploaded_photo": {{ 'personalizer.uploaded_photo' | t | json }},
        "added_to_front_canvas": {{ 'personalizer.added_to_front_canvas' | t | json }},
        "added_to_back_canvas": {{ 'personalizer.added_to_back_canvas' | t | json }},
        "cancel": {{ 'personalizer.cancel' | t | json }},
        "add_to_cart": {{ 'personalizer.add_to_cart' | t | json }},
        "adding_to_cart": {{ 'personalizer.adding_to_cart' | t | json }},
        "uploading_front_design": {{ 'personalizer.uploading_front_design' | t | json }},
        "uploading_back_design": {{ 'personalizer.uploading_back_design' | t | json }},
        "uploading_front_photo": {{ 'personalizer.uploading_front_photo' | t | json }},
        "uploading_back_photo": {{ 'personalizer.uploading_back_photo' | t | json }},
        "uploading_photo": {{ 'personalizer.uploading_photo' | t | json }},
        "preparing_canvas": {{ 'personalizer.preparing_canvas' | t | json }},
        "error_select_variant": {{ 'personalizer.error_select_variant' | t | json }},
        "error_add_to_cart": {{ 'personalizer.error_add_to_cart' | t | json }}
      }
    </script>
    {% if current_product and current_product.variants.size > 0 %}
      <script type="application/json" class="saitriq-variants-json">
        {
          "options": {{ current_product.options_with_values | json }},
          "images": [
            {% for img in current_product.images %}
              {
                "url": {{ img | image_url: width: 1200 | json }},
                "alt": {{ img.alt | default: '' | json }}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          "variants": [
            {% for variant in current_product.variants %}
              {
                "id": {{ variant.id | json }},
                "title": {{ variant.title | json }},
                "available": {{ variant.available | json }},
                "options": {{ variant.options | json }},
                "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1200 | json }}{% elsif variant.featured_media %}{{ variant.featured_media | image_url: width: 1200 | json }}{% else %}null{% endif %}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }
      </script>
    {% endif %}
    <div class="saitriq-trigger-wrapper">
      <button
        type="button"
        class="saitriq-customize-btn"
        style="background-color: {{ btn_color | escape }};"
      >
        {{ btn_text | escape }}
      </button>
    </div>
  </saitriq-personalizer>
</div>

{% schema %}
{
  "name": "Product Personalizer",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Customize Button Text",
      "default": "🎨 Customize This Product"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Accent Color",
      "default": "#008060"
    },
    {
      "type": "checkbox",
      "id": "auto_open",
      "label": "Open personalizer studio inline on page load",
      "default": false
    },
    {
      "type": "text",
      "id": "app_url",
      "label": "Custom App Backend URL",
      "info": "Optional: Only needed if not using default Shopify App Proxy"
    }
  ]
}
{% endschema %}
